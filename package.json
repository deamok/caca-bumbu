{
  "name": "caca-bumbu",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Caca Bumbu — aplikasi penjualan bumbu rumahan untuk warung",
  "packageManager": "pnpm@10.4.1",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cloud": "node scripts/cloud-e2e.mjs",
    "db:apply": "node scripts/apply-supabase.mjs",
    "check:live": "node scripts/live-check.mjs"
  },
  "dependencies": {
    "@fontsource/fraunces": "^5.3.0",
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "@supabase/supabase-js": "^2.119.2",
    "lucide-react": "^1.76.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^26.1.0",
    "playwright": "^1.65.1",
    "typescript": "~5.7.3",
    "vite": "^6.4.6",
    "vitest": "^3.2.7"
  },
  "homepage": "https://caca-bumbu.vercel.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/deamok/caca-bumbu.git"
  },
  "author": "deamok",
